+# Required by the Replit/Vite workspace build.
+PORT=5000
+BASE_PATH=/
+
+# Clerk identity boundary for the governed Hub.
+VITE_CLERK_PUBLISHABLE_KEY=
+VITE_CLERK_PROXY_URL=
+
+# Public JALDO site shown in controlled Hub hand-off screens. Must be HTTPS.
+VITE_JALDO_MAIN_URL=
+
+# Server-side-only canonical Core API. Must be a stable HTTPS deployment URL,
+# not a temporary Replit development or preview address.
+RTBX_CORE_API_BASE_URL=
