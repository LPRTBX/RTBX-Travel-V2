{
  "name": "jaldo-travel-workspace-harness",
  "private": true,
  "version": "0.0.0",
  "description": "Isolated, synthetic review workspace that runs the pinned JALDO Core kernel in the browser. Not a workspace package: normal installs and CI never see it.",
  "type": "module",
  "scripts": {
    "check:core-pin": "node check-core-pin.mjs",
    "typecheck": "node ../../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node ../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "package": "node scripts/package-single.mjs",
    "build": "node ../node_modules/vite/bin/vite.js build --config vite.config.ts",
    "dev": "node ../node_modules/vite/bin/vite.js --config vite.config.ts",
    "preview": "node ../node_modules/vite/bin/vite.js preview --config vite.config.ts",
    "verify": "node scripts/verify.mjs"
  }
}
